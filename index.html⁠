<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JARVIS - Core HUD</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Rajdhani', sans-serif; }
        body { background-color: #050811; color: #00f3ff; height: 100vh; display: flex; flex-direction: column; justify-content: space-between; padding: 15px; overflow: hidden; }
        
        /* HUD Header */
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(0, 243, 255, 0.3); padding-bottom: 10px; font-family: 'Orbitron', sans-serif; }
        .sys-status { font-size: 12px; color: #00ff88; text-shadow: 0 0 5px #00ff88; }
        .sys-title { font-size: 18px; font-weight: 900; letter-spacing: 2px; color: #ffffff; text-shadow: 0 0 10px #00f3ff; }

        /* Arc Reactor Central Visualizer */
        .arc-container { display: flex; justify-content: center; align-items: center; margin: 15px 0; }
        .arc-reactor { width: 90px; height: 90px; border-radius: 50%; border: 2px solid #00f3ff; box-shadow: 0 0 15px #00f3ff, inset 0 0 15px #00f3ff; display: flex; justify-content: center; align-items: center; position: relative; animation: pulse 3s infinite ease-in-out; }
        .arc-core { width: 45px; height: 45px; border-radius: 50%; background: #ffffff; box-shadow: 0 0 20px #00f3ff, 0 0 40px #00f3ff; }
        @keyframes pulse { 0% { transform: scale(0.98); box-shadow: 0 0 10px #00f3ff; } 50% { transform: scale(1.05); box-shadow: 0 0 25px #00f3ff, 0 0 40px #00f3ff; } 100% { transform: scale(0.98); box-shadow: 0 0 10px #00f3ff; } }
        .speaking { animation: speak-pulse 0.6s infinite alternate !important; }
        @keyframes speak-pulse { 0% { transform: scale(1); box-shadow: 0 0 20px #ff0055; } 100% { transform: scale(1.15); box-shadow: 0 0 45px #ff0055; } }

        /* Chat Output Area */
        #chat-container { flex-grow: 1; overflow-y: auto; background: rgba(0, 15, 30, 0.6); border: 1px solid rgba(0, 243, 255, 0.2); border-radius: 8px; padding: 12px; margin-bottom: 15px; display: flex; flex-direction: column; gap: 10px; }
        .msg { padding: 10px 14px; border-radius: 6px; max-width: 85%; font-size: 15px; line-height: 1.4; }
        .user-msg { background: rgba(0, 243, 255, 0.15); border-left: 3px solid #00f3ff; align-self: flex-end; color: #ffffff; }
        .jarvis-msg { background: rgba(0, 255, 136, 0.1); border-left: 3px solid #00ff88; align-self: flex-start; color: #e0e0e0; }

        /* Controls / Input */
        .controls { display: flex; gap: 8px; align-items: center; }
        input[type="text"] { flex-grow: 1; background: rgba(0, 10, 20, 0.8); border: 1px solid #00f3ff; border-radius: 5px; padding: 12px; color: #fff; font-size: 16px; outline: none; }
        input[type="text"]:focus { box-shadow: 0 0 8px #00f3ff; }
        button { background: #00f3ff; color: #050811; border: none; padding: 12px 16px; font-weight: 700; font-family: 'Orbitron', sans-serif; border-radius: 5px; cursor: pointer; }
        .mic-btn { background: #ff0055; color: #fff; box-shadow: 0 0 10px #ff0055; }
    </style>
</head>
<body>

    <header>
        <div class="sys-status">● SYSTEM: ONLINE</div>
        <div class="sys-title">JARVIS AI</div>
        <div class="sys-status">STARK OS</div>
    </header>

    <div class="arc-container">
        <div class="arc-reactor" id="reactor">
            <div class="arc-core"></div>
        </div>
    </div>

    <div id="chat-container">
        <div class="msg jarvis-msg">Sistemi pronti, Signore. In attesa di istruzioni strategiche, personali o di business.</div>
    </div>

    <div class="controls">
        <button class="mic-btn" onclick="startVoiceManual()">MIC</button>
        <input type="text" id="userInput" placeholder="Comanda Jarvis..." onkeypress="handleKey(event)">
        <button onclick="sendMessageFromInput()">INVIO</button>
    </div>

    <script>
        const chat = document.getElementById('chat-container');
        const reactor = document.getElementById('reactor');
        let recognition;
        let isSpeaking = false;

        function appendMessage(sender, text) {
            const div = document.createElement('div');
            div.className = `msg ${sender}-msg`;
            div.innerText = text;
            chat.appendChild(div);
            chat.scrollTop = chat.scrollHeight;
        }

        async function sendMessage(text) {
            if (!text) return;
            appendMessage('user', text);

            try {
                const response = await fetch('/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                });
                const data = await response.json();
                appendMessage('jarvis', data.reply);
                speak(data.reply);
            } catch (err) {
                appendMessage('jarvis', 'Errore di collegamento con la matrice principale.');
                restartListening();
            }
        }

        function sendMessageFromInput() {
            const input = document.getElementById('userInput');
            const text = input.value.trim();
            if (!text) return;
            input.value = '';
            sendMessage(text);
        }

        function handleKey(e) { if (e.key === 'Enter') sendMessageFromInput(); }

        function initVoice() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) return;

            recognition = new SpeechRecognition();
            recognition.lang = 'it-IT';
            recognition.continuous = false;
            recognition.interimResults = false;

            recognition.onstart = () => {
                if (!isSpeaking) reactor.classList.add('speaking');
            };

            recognition.onend = () => {
                reactor.classList.remove('speaking');
                if (!isSpeaking) {
                    setTimeout(() => { try { recognition.start(); } catch(e){} }, 500);
                }
            };

            recognition.onresult = (e) => {
                const transcript = e.results[0][0].transcript;
                if (transcript.trim()) {
                    sendMessage(transcript);
                }
            };

            try { recognition.start(); } catch(e){}
        }

        function startVoiceManual() {
            if (recognition) {
                try { recognition.start(); } catch(e){}
            } else {
                initVoice();
            }
        }

        function speak(text) {
            if ('speechSynthesis' in window) {
                const synth = window.speechSynthesis;
                synth.cancel();

                const utter = new SpeechSynthesisUtterance(text);
                utter.lang = 'it-IT';
                utter.pitch = 0.9;
                utter.rate = 1.0;

                utter.onstart = () => {
                    isSpeaking = true;
                    reactor.classList.add('speaking');
                    try { recognition.stop(); } catch(e){}
                };

                utter.onend = () => {
                    isSpeaking = false;
                    reactor.classList.remove('speaking');
                    restartListening();
                };

                synth.speak(utter);
            } else {
                restartListening();
            }
        }

        function restartListening() {
            if (!isSpeaking && recognition) {
                setTimeout(() => { try { recognition.start(); } catch(e){} }, 500);
            }
        }

        window.addEventListener('DOMContentLoaded', () => { initVoice(); });
        document.body.addEventListener('click', () => {
            if (!isSpeaking && recognition) {
                try { recognition.start(); } catch(e){}
            }
        }, { once: true });
    </script>
</body>
</html>
